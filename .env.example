#--------------------------------------------------------------------
# Environment Configuration for Desentra
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
# Jika menggunakan Docker Compose:
# database.default.hostname = db
# database.default.username = desentra_user
# database.default.password = desentra_password

# Jika menggunakan Local Windows / Laragon / XAMPP:
database.default.hostname = 127.0.0.1
database.default.database = desentra
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# SECURITY / CSRF
#--------------------------------------------------------------------
# security.csrfProtection = 'cookie'
# security.tokenRandomize = true

#--------------------------------------------------------------------
# DESENTRA AI (GEMINI) CONFIGURATION
#--------------------------------------------------------------------
GEMINI_API_KEY = ''
GEMINI_MODEL = 'gemini-1.5-flash'

#--------------------------------------------------------------------
# DESENTRA VILLAGE INFO
#--------------------------------------------------------------------
DESENTRA_VILLAGE_NAME = 'Silagar, Cangkreplor, Purworejo'
DESENTRA_DISTRICT_NAME = 'Platform pusat layanan masyarakat'
DESENTRA_REGENCY_NAME = 'Kabupaten Purworejo'
DESENTRA_OFFICIAL_CONTACT = '+62 812-3456-7890'

# Encryption key (generate via: php spark key:generate)
encryption.key = 
